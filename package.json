{
  "name": "bolso-em-dia",
  "version": "1.1.0",
  "private": true,
  "description": "Finanças pessoais num arquivo HTML só, com sincronização opcional numa planilha do Google.",
  "scripts": {
    "build": "python3 montar.py",
    "lint:js": "eslint fonte/app.js Code.gs testes eslint.config.mjs",
    "lint:css": "stylelint fonte/estilo.css",
    "lint:html": "python3 montar.py && html-validate dist/Index.html dist/bolso-em-dia.html",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "test": "node --test testes/*.test.js",
    "check": "npm run lint && npm test && npm audit --audit-level=low"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "html-validate": "11.23.0",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0"
  }
}
